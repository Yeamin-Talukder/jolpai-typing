rules_version = '2';

// Jolpai Typing: each signed-in person can read and write only their own
// profile and results. Nobody else can read them.
service cloud.firestore {
  match /databases/{database}/documents {

    // A shared profile: a public copy someone chose to publish. Anyone with
    // the link can read it; nobody can list them; only the owner can write
    // or delete it. It never holds an email address.
    function validShare(d) {
      return d.keys().hasOnly(['owner', 'name', 'photo', 'joined', 'updated', 'tests', 'time', 'results'])
        && d.keys().hasAll(['owner', 'name', 'updated', 'tests', 'time', 'results'])
        && d.owner == request.auth.uid
        && d.name is string && d.name.size() <= 100
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() <= 1000))
        && (!('joined' in d) || d.joined == null || d.joined is int)
        && d.updated is timestamp
        && d.tests is int && d.tests >= 0
        && (d.time is int || d.time is float) && d.time >= 0
        && d.results is list && d.results.size() <= 500;
    }

    // Course progress: one document per person, written whole each time.
    function validLearn(d) {
      return d.keys().hasOnly(['v', 'lessons', 'keyStats', 'days', 'secs', 'openAll', 'exams', 'updated'])
        && d.keys().hasAll(['v', 'lessons', 'keyStats', 'days', 'secs', 'openAll', 'updated'])
        && d.v == 1
        && d.lessons is map && d.lessons.size() <= 100
        && d.keyStats is map && d.keyStats.size() <= 200
        && d.days is list && d.days.size() <= 400
        && (d.secs is int || d.secs is float) && d.secs >= 0
        && d.openAll is bool
        && (!('exams' in d) || (d.exams is list && d.exams.size() <= 50))
        && d.updated is timestamp;
    }

    // Site-wide numbers for the About page: one public document, stats/site.
    // Anyone may read it. Anyone (guests too) may add exactly one finished
    // test or one finished course lesson, with a realistic length; a signed-in
    // person may add themselves once, in the same write that creates their
    // profile. Every other counter must stay the same.
    function step(k) {
      return request.resource.data[k] - (resource == null ? 0 : resource.data[k]);
    }
    function statsShape(d) {
      return d.keys().hasOnly(['tests', 'bangla', 'english', 'lessons', 'seconds', 'typists', 'accounts'])
        && d.keys().hasAll(['tests', 'bangla', 'english', 'lessons', 'seconds', 'typists', 'accounts'])
        && d.tests is int && d.bangla is int && d.english is int && d.lessons is int
        && d.typists is int && d.accounts is int && (d.seconds is int || d.seconds is float);
    }
    function oneTest() {
      return step('tests') == 1 && step('bangla') + step('english') == 1 && step('bangla') >= 0 && step('english') >= 0
        && step('lessons') == 0 && step('accounts') == 0
        && step('seconds') >= 5 && step('seconds') <= 3600
        && step('typists') >= 0 && step('typists') <= 1;
    }
    function oneLesson() {
      return step('lessons') == 1 && step('tests') == 0 && step('bangla') == 0 && step('english') == 0 && step('accounts') == 0
        && step('seconds') > 0 && step('seconds') <= 3600
        && step('typists') >= 0 && step('typists') <= 1;
    }
    function oneAccount() {
      return step('accounts') == 1
        && step('tests') == 0 && step('bangla') == 0 && step('english') == 0 && step('lessons') == 0
        && step('seconds') == 0 && step('typists') == 0
        && request.auth != null
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /stats/{doc} {
      allow get: if doc == 'site';
      allow list, delete: if false;
      allow create, update: if doc == 'site' && statsShape(request.resource.data)
        && (oneTest() || oneLesson() || oneAccount());
    }

    match /shared/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && validShare(request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && validShare(request.resource.data);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNum(v, lo, hi) {
      return (v is int || v is float) && v >= lo && v <= hi;
    }

    // optional detail fields: absent, or the right type and size
    function optNum(d, k, lo, hi) {
      return !(k in d) || isNum(d[k], lo, hi);
    }
    function optList(d, k, max) {
      return !(k in d) || (d[k] is list && d[k].size() <= max);
    }

    function validResult(d, id) {
      return d.keys().hasOnly(['id', 't', 'lang', 'mode', 'amount', 'label', 'wpm', 'net', 'raw', 'acc', 'sec',
                               'chars', 'cons', 'words', 'wrong', 'hw', 'hr', 'he', 'dev'])
        && d.keys().hasAll(['id', 't', 'lang', 'mode', 'amount', 'label', 'wpm', 'net', 'raw', 'acc', 'sec'])
        && d.id == id
        && d.t is int
        && d.lang in ['english', 'bangla']
        && d.mode in ['time', 'words', 'passage', 'lesson', 'custom']
        && isNum(d.amount, 0, 3600)
        && d.label is string && d.label.size() <= 40
        && isNum(d.wpm, 0, 1000) && isNum(d.net, 0, 1000) && isNum(d.raw, 0, 1000)
        && isNum(d.acc, 0, 100)
        && isNum(d.sec, 0, 3600)
        && optList(d, 'chars', 4)
        && optNum(d, 'cons', 0, 100)
        && optNum(d, 'words', 0, 100000)
        && optNum(d, 'wrong', 0, 100000)
        && optList(d, 'hw', 700) && optList(d, 'hr', 700) && optList(d, 'he', 700)
        && (!('dev' in d) || d.dev in ['desktop', 'mobile']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'lastSeen', 'shareId'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (!('shareId' in request.resource.data) || request.resource.data.shareId == null
            || (request.resource.data.shareId is string && request.resource.data.shareId.size() <= 40));
      allow delete: if isOwner(uid);

      match /learn/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'progress' && validLearn(request.resource.data);
      }

      match /results/{resultId} {
        allow read, delete: if isOwner(uid);
        // results are written once and never edited
        allow create: if isOwner(uid) && validResult(request.resource.data, resultId);
        allow update: if false;
      }
    }
  }
}
